{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appId": {
      "type": "string"
    },
    "scripts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "description": "Instructions on how to configure the script: plain text, with a blank line between paragraphs, or a Tiptap rich-text document",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/TiptapDoc"
                  }
                ]
              },
              "entrypoint": {
                "type": "string"
              },
              "configSchema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["string", "number", "mapping"]
                    },
                    "description": {
                      "type": "string"
                    },
                    "dataType": {
                      "type": "string",
                      "enum": ["None", "Account", "User", "Event"]
                    }
                  },
                  "required": ["name", "type"],
                  "additionalProperties": false
                }
              },
              "authSchema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "mapping": {
                          "type": "boolean"
                        }
                      },
                      "required": ["description"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "slug": {
                "description": "Stable public key used in incoming webhook URLs. Generated on create when omitted.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["incoming"]
              }
            },
            "required": ["name", "entrypoint", "configSchema", "authSchema", "permissions", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "description": "Instructions on how to configure the script: plain text, with a blank line between paragraphs, or a Tiptap rich-text document",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/TiptapDoc"
                  }
                ]
              },
              "entrypoint": {
                "type": "string"
              },
              "configSchema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["string", "number", "mapping"]
                    },
                    "description": {
                      "type": "string"
                    },
                    "dataType": {
                      "type": "string",
                      "enum": ["None", "Account", "User", "Event"]
                    }
                  },
                  "required": ["name", "type"],
                  "additionalProperties": false
                }
              },
              "authSchema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "mapping": {
                          "type": "boolean"
                        }
                      },
                      "required": ["description"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "slug": {
                "description": "Stable public key used in incoming webhook URLs. Generated on create when omitted.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["outgoing"]
              },
              "dataType": {
                "type": "string",
                "enum": ["Account", "Company", "User", "Event"]
              }
            },
            "required": ["name", "entrypoint", "configSchema", "authSchema", "permissions", "type", "dataType"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "description": "Instructions on how to configure the script: plain text, with a blank line between paragraphs, or a Tiptap rich-text document",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/TiptapDoc"
                  }
                ]
              },
              "entrypoint": {
                "type": "string"
              },
              "configSchema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["string", "number", "mapping"]
                    },
                    "description": {
                      "type": "string"
                    },
                    "dataType": {
                      "type": "string",
                      "enum": ["None", "Account", "User", "Event"]
                    }
                  },
                  "required": ["name", "type"],
                  "additionalProperties": false
                }
              },
              "authSchema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "mapping": {
                          "type": "boolean"
                        }
                      },
                      "required": ["description"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "slug": {
                "description": "Stable public key used in incoming webhook URLs. Generated on create when omitted.",
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["scheduled"]
              },
              "cron": {
                "type": "string"
              }
            },
            "required": ["name", "entrypoint", "configSchema", "authSchema", "permissions", "type", "cron"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["appId", "scripts"],
  "additionalProperties": false,
  "$defs": {
    "TiptapDoc": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TiptapParagraph"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "heading"
                  },
                  "attrs": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      }
                    },
                    "required": ["level"],
                    "additionalProperties": false
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "text": {
                          "type": "string"
                        },
                        "marks": {
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": ["bold", "underline", "strike"]
                                  }
                                },
                                "required": ["type"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "const": "link"
                                  },
                                  "attrs": {
                                    "type": "object",
                                    "properties": {
                                      "href": {
                                        "type": "string"
                                      },
                                      "rel": {
                                        "type": "string"
                                      },
                                      "target": {
                                        "anyOf": [
                                          {
                                            "type": "string"
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      "class": {
                                        "anyOf": [
                                          {
                                            "type": "string"
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      }
                                    },
                                    "required": ["href", "rel", "target", "class"],
                                    "additionalProperties": false
                                  }
                                },
                                "required": ["type", "attrs"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      },
                      "required": ["type", "text"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["type", "attrs", "content"],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/TiptapBulletList"
              },
              {
                "$ref": "#/$defs/TiptapOrderedList"
              }
            ]
          }
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false,
      "description": "Tiptap rich-text document, the shape the Terros API stores"
    },
    "TiptapParagraph": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "marks": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["bold", "underline", "strike"]
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "link"
                        },
                        "attrs": {
                          "type": "object",
                          "properties": {
                            "href": {
                              "type": "string"
                            },
                            "rel": {
                              "type": "string"
                            },
                            "target": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "class": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": ["href", "rel", "target", "class"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["type", "attrs"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["type", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "TiptapBulletList": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bulletList"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiptapListItem"
          }
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "TiptapListItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "listItem"
        },
        "content": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TiptapBulletList"
              },
              {
                "$ref": "#/$defs/TiptapOrderedList"
              },
              {
                "$ref": "#/$defs/TiptapParagraph"
              }
            ]
          }
        }
      },
      "required": ["type", "content"],
      "additionalProperties": false
    },
    "TiptapOrderedList": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "orderedList"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "type": {
              "type": "null"
            }
          },
          "required": ["start", "type"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiptapListItem"
          }
        }
      },
      "required": ["type", "attrs", "content"],
      "additionalProperties": false
    }
  }
}
