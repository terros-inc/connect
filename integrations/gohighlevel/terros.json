{
  "appId": "App.e8sApZ32j4u_H_OMJUYAn",
  "scripts": [
    {
      "name": "GoHighLevel Account Sync",
      "entrypoint": "src/outgoing.ts",
      "type": "outgoing",
      "dataType": "Account",
      "configSchema": [
        {
          "name": "locationId",
          "type": "string",
          "description": "GoHighLevel location/sub-account ID"
        },
        {
          "name": "pipelineId",
          "type": "string",
          "description": "GoHighLevel pipeline ID"
        },
        {
          "name": "stageMappings",
          "type": "mapping",
          "dataType": "None",
          "description": "Map Terros workflow stage names to GoHighLevel pipeline stage names"
        },
        {
          "name": "contactFieldMappings",
          "type": "mapping",
          "dataType": "Account",
          "description": "Map an account field to a GHL custom contact field using merge-field key"
        }
      ],
      "authSchema": {
        "privateIntegrationToken": "GoHighLevel private integration token"
      },
      "permissions": ["account:save"],
      "slug": "gohighlevel-account-sync"
    },
    {
      "name": "GoHighLevel Opportunity Webhook",
      "entrypoint": "src/incoming.ts",
      "type": "incoming",
      "configSchema": [
        {
          "name": "locationId",
          "type": "string",
          "description": "GoHighLevel location/sub-account ID"
        },
        {
          "name": "stageMappings",
          "type": "mapping",
          "dataType": "None",
          "description": "Map Terros workflow stage names to GoHighLevel pipeline stage names"
        }
      ],
      "authSchema": {},
      "permissions": ["account:list", "account:save"],
      "slug": "gohighlevel-opportunity-webhook"
    },
    {
      "name": "GoHighLevel Appointment Sync",
      "entrypoint": "src/calendar.ts",
      "type": "outgoing",
      "dataType": "Event",
      "configSchema": [
        {
          "name": "locationId",
          "type": "string",
          "description": "GoHighLevel location/sub-account ID"
        },
        {
          "name": "calendarId",
          "type": "string",
          "description": "GoHighLevel calendar ID"
        },
        {
          "name": "pipelineId",
          "type": "string",
          "description": "GoHighLevel pipeline ID"
        },
        {
          "name": "stageMappings",
          "type": "mapping",
          "dataType": "None",
          "description": "Map Terros workflow stage names to GoHighLevel pipeline stage names"
        }
      ],
      "authSchema": {
        "privateIntegrationToken": "GoHighLevel private integration token"
      },
      "permissions": ["account:list", "event:save"],
      "slug": "gohighlevel-appointment-sync"
